# Server-Port
PORT=8080

# ~1 KI pro N Spielende (z.B. 7 -> 1 KI bei 3-13, 2 ab 14 ...)
KI_RATIO=7

# Runde 2: Eliminierungen pro Runde = aufgerundet(lebende / DIV)
R2_ELIM_DIV=8

# Optional: echte KI als Vorbelegung fuer das Host-Panel in der Lobby.
# OpenAI-kompatibler Endpunkt (Ollama, LM Studio, llama.cpp-server, vLLM ...).
# Ollama-Beispiel: LLM_URL=http://192.168.1.50:11434  LLM_MODEL=smollm2:1.7b
# LLM_URL=
# LLM_MODEL=
# LLM_KEY=
# LLM_TIMEOUT_MS=60000

# Output klein halten (schnell auch auf CPU): Anzahl Vorschlaege (2-5), Token-Budget, Woerter pro Antwort
# LLM_ANSWERS=3
# LLM_MAX_TOKENS=120
# LLM_MAX_WORDS=12
# Eigener System-Prompt (ueberschreibt den eingebauten komplett)
# LLM_SYSTEM_PROMPT=
